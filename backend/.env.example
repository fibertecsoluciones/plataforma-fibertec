# En Railway, la variable DATABASE_URL la crea automáticamente el plugin de PostgreSQL.
# Cópiala tal cual a las variables de entorno del servicio backend.
DATABASE_URL=postgresql://usuario:password@host:5432/railway

# Puerto en el que corre el servidor (Railway lo asigna solo, no lo cambies en producción)
PORT=4000

# Clave secreta para firmar los tokens de sesión (JWT). Cambiar por una cadena larga y aleatoria.
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Origen permitido para CORS (URL de tu frontend). Usa * solo en desarrollo.
CORS_ORIGIN=*

# Credenciales del usuario admin inicial (usadas solo por db:seed-admin)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador
